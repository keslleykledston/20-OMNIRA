# Multi-stage build para omnira-api
# Stage 1: Builder
FROM golang:1.25-alpine AS builder

WORKDIR /build

# Instalar dependências de build
RUN apk add --no-cache git ca-certificates tzdata

# Copiar módulos
COPY go.mod go.sum ./
RUN go mod download

# Copiar código
COPY . .

# Build com metadata
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_TIME=unknown

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
  -ldflags "-s -w \
    -X github.com/omnira/omnira/internal/platform/config.Version=${VERSION} \
    -X github.com/omnira/omnira/internal/platform/config.Commit=${COMMIT} \
    -X github.com/omnira/omnira/internal/platform/config.BuildTime=${BUILD_TIME}" \
  -o /build/omnira-api \
  ./apps/api/cmd/omnira-api

# Stage 2: Runtime
FROM alpine:latest

# Instalar certificados CA (necessário para TLS)
RUN apk add --no-cache ca-certificates tzdata

# Criar usuário não-root
RUN addgroup -g 1000 omnira && adduser -D -u 1000 -G omnira omnira

WORKDIR /app

# Copiar binário do builder
COPY --from=builder /build/omnira-api /app/omnira-api

# Permissões
RUN chown -R omnira:omnira /app

# ADR-0016: media directory owned by the runtime user, so a fresh named volume inherits it
RUN mkdir -p /var/lib/omnira/media && chown omnira:omnira /var/lib/omnira/media

# Switch para usuário não-root
USER omnira

# Health check
HEALTHCHECK --interval=10s --timeout=3s --retries=3 --start-period=5s \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/internal/health/live || exit 1

# Endpoint padrão
EXPOSE 8080

# Graceful shutdown
STOPSIGNAL SIGTERM

# Entrypoint
ENTRYPOINT ["/app/omnira-api"]
