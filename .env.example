# OMNIRA — template de configuração. Copie para .env e preencha.
# .env NUNCA entra no Git. Nenhum valor real aqui, apenas placeholders.

# --- Aplicação ---
OMNIRA_ENV=development
OMNIRA_HTTP_ADDR=:8080
# Runtime connects as the application role omnira_app (never the owner: a superuser bypasses RLS).
OMNIRA_DATABASE_URL=postgres://omnira_app:CHANGE_ME@localhost:55434/omnira_dev?sslmode=disable
OMNIRA_NATS_URL=nats://localhost:4222
OMNIRA_OTEL_ENDPOINT=http://localhost:4317
OMNIRA_AUTH_ISSUER=http://localhost:8080
OMNIRA_AUTH_AUDIENCE=omnira
OMNIRA_GRACEFUL_SHUTDOWN=30
# Base64 de exatamente 32 bytes aleatórios. Nunca use chave real aqui.
OMNIRA_CREDENTIALS_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
OMNIRA_WAHA_ENABLED=false
OMNIRA_WAHA_BASE_URL=http://waha:3000
# Plaintext client key: inject from secret manager/runtime; never commit real value.
OMNIRA_WAHA_API_KEY=REPLACE_WITH_WAHA_PLAINTEXT_KEY
OMNIRA_WAHA_ENGINE=GOWS
# WAHA container expects hash form for same key. Generate externally; never commit real hash.
WAHA_API_KEY=sha512:REPLACE_WITH_WAHA_SHA512_HEX_HASH

# --- Local AI (OPCIONAL — otimização de engenharia, não dependência do produto) ---
# Desligue com LOCAL_AI_ENABLED=false: build, testes, CI e a aplicação
# continuam funcionando normalmente. Veja docs/architecture/LOCAL-AI.md.
LOCAL_AI_ENABLED=true
LOCAL_AI_BASE_URL=http://127.0.0.1:18088
LOCAL_AI_MODEL=hermes-3-llama-3.1-8b
LOCAL_AI_API_KEY=
LOCAL_AI_TIMEOUT=45
LOCAL_AI_MAX_INPUT_CHARS=12000

# --- Compose / provisioning (docker-compose.yml) ---
# Database name and passwords used by compose. Change the defaults outside local development.
OMNIRA_DB_NAME=omnira_dev
POSTGRES_PASSWORD=CHANGE_ME_OWNER_PASSWORD
# Password of the application role omnira_app; the `migrate` service applies it (migration 000006 creates
# the role with the development password "omnira_app"). Must match the password in OMNIRA_DATABASE_URL.
OMNIRA_APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD
# Adopt a database whose schema was applied by hand: last already-applied migration prefix (e.g. 000027).
OMNIRA_MIGRATE_BASELINE=

# --- WhatsApp (WAHA) ---
# URL WAHA uses to call this API back (webhook). From the compose network: http://api:8080
OMNIRA_PUBLIC_BASE_URL=http://api:8080

# --- Safety valve (do NOT use in production) ---
# API/worker refuse to start when connected as a superuser/BYPASSRLS role (RLS would be a no-op).
OMNIRA_ALLOW_PRIVILEGED_DB=false
