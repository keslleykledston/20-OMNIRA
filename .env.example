# OMNIRA — template de configuração. Copie para .env e preencha.
# .env NUNCA entra no Git. Nenhum valor real aqui, apenas placeholders.

# --- Aplicação ---
OMNIRA_ENV=development
OMNIRA_HTTP_ADDR=:8080
# Runtime connects as the application role omnira_app (never the owner: a superuser bypasses RLS).
OMNIRA_DATABASE_URL=postgres://omnira_app:CHANGE_ME@localhost:55434/omnira_dev?sslmode=disable
OMNIRA_NATS_URL=nats://localhost:4222
OMNIRA_OTEL_ENDPOINT=http://localhost:4317
# `mock` somente em development/test; produção deve usar `oidc`.
OMNIRA_AUTH_MODE=mock
# Login de desenvolvimento (POST /api/v1/auth/dev/login, sem senha). Só vale em
# OMNIRA_ENV local/dev/development/lab/test; ligado em staging ou production a
# API recusa o boot, para que um deploy mal configurado apareça na hora.
OMNIRA_DEV_AUTH_ENABLED=false
OMNIRA_AUTH_ISSUER=https://idp.example.com/realms/omnira
OMNIRA_AUTH_AUDIENCE=omnira-web
OMNIRA_AUTH_CLIENT_ID=omnira-web
# Injetar por secret manager/runtime; nunca commitar valor real.
OMNIRA_AUTH_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
OMNIRA_AUTH_REDIRECT_URL=https://omnira.devops.k3gsolutions.com.br/api/v1/auth/oidc/callback
OMNIRA_AUTH_POST_LOGIN_URL=/login?oidc=complete
OMNIRA_AUTH_COOKIE_SECURE=false
# Native app credentials (ADR-0022, MOBILE.1). Off by default. Needs OMNIRA_AUTH_MODE=oidc, a public OIDC client (default id omnira-mobile,
# Code+PKCE, no secret) and the exact redirect URIs the app uses (comma separated; no wildcards).
OMNIRA_AUTH_MOBILE_ENABLED=false
OMNIRA_AUTH_MOBILE_CLIENT_ID=omnira-mobile
OMNIRA_AUTH_MOBILE_REDIRECT_URIS=
OMNIRA_GRACEFUL_SHUTDOWN=30
# Base64 de exatamente 32 bytes aleatórios. Nunca use chave real aqui.
OMNIRA_CREDENTIALS_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
OMNIRA_WAHA_ENABLED=false
OMNIRA_WAHA_BASE_URL=http://waha:3000
# Plaintext client key: inject from secret manager/runtime; never commit real value.
OMNIRA_WAHA_API_KEY=REPLACE_WITH_WAHA_PLAINTEXT_KEY
OMNIRA_WAHA_ENGINE=GOWS
# WAHA container expects hash form for same key. Generate externally; never commit real hash.
WAHA_API_KEY=sha512:REPLACE_WITH_WAHA_SHA512_HEX_HASH

# --- Local AI (OPCIONAL — otimização de engenharia, não dependência do produto) ---
# Desligue com LOCAL_AI_ENABLED=false: build, testes, CI e a aplicação
# continuam funcionando normalmente. Veja docs/architecture/LOCAL-AI.md.
LOCAL_AI_ENABLED=true
LOCAL_AI_BASE_URL=http://127.0.0.1:18088
LOCAL_AI_MODEL=hermes-3-llama-3.1-8b
LOCAL_AI_API_KEY=
LOCAL_AI_TIMEOUT=45
LOCAL_AI_MAX_INPUT_CHARS=12000

# --- Compose / provisioning (docker-compose.yml) ---
# Database name and passwords used by compose. Change the defaults outside local development.
OMNIRA_DB_NAME=omnira_dev
POSTGRES_PASSWORD=CHANGE_ME_OWNER_PASSWORD
# Password of the application role omnira_app; the `migrate` service applies it (migration 000006 creates
# the role with the development password "omnira_app"). Must match the password in OMNIRA_DATABASE_URL.
OMNIRA_APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD
# Adopt a database whose schema was applied by hand: last already-applied migration prefix (e.g. 000027).
OMNIRA_MIGRATE_BASELINE=

# --- Keycloak (OIDC IdP) ---
# Keycloak admin user/password for initial setup. Use strong values in production.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_PASSWORD
KEYCLOAK_DB_PASSWORD=CHANGE_ME_KEYCLOAK_DB_PASSWORD
# Public hostname Keycloak reports to clients (discovery). Local dev: localhost:8888.
# Production: idp.omnira.k3g.internal or similar (coerces issuer URL).
KEYCLOAK_HOSTNAME=localhost:8888

# --- WhatsApp (WAHA) ---
# URL WAHA uses to call this API back (webhook). From the compose network: http://api:8080
OMNIRA_PUBLIC_BASE_URL=http://api:8080

# --- Convites por e-mail (IAM2C) ---
# Host do FRONTEND como o navegador do convidado o enxerga (links dos e-mails). Obrigatório com SMTP.
# OMNIRA_WEB_BASE_URL=https://omnira.devops.k3gsolutions.com.br
# SMTP real (produção: STARTTLS ou TLS implícito; senha nunca em log). Sem OMNIRA_SMTP_HOST não há envio.
# OMNIRA_SMTP_HOST=smtp.exemplo.com
# OMNIRA_SMTP_PORT=587
# OMNIRA_SMTP_USERNAME=
# OMNIRA_SMTP_PASSWORD=
# OMNIRA_SMTP_FROM="OMNIRA <no-reply@exemplo.com>"
# OMNIRA_SMTP_REPLY_TO=
# OMNIRA_SMTP_TLS=starttls   # starttls | implicit | none (none só em dev, ex.: Mailpit)
# Dev com Mailpit (docker compose --profile dev up mailpit): host mailpit, porta 1025, TLS none, UI :8025.

# --- IA da plataforma (OPCIONAL; desligada por padrão). Veja docs/ai/PLATFORM-AI-PROVIDERS.md ---
# Ligar envia trechos de conversas de clientes ao provedor. Chave só aqui, nunca no Git.
# OMNIRA_AI_ENABLED=true
# OMNIRA_AI_PROVIDER=gemini            # openai (padrão) | gemini
# OMNIRA_AI_MODEL=gemini-3.5-flash-lite
# OMNIRA_GEMINI_API_KEY=               # ou OMNIRA_AI_API_KEY
# OMNIRA_COPILOT_ENABLED=true

# --- Safety valve (do NOT use in production) ---
# API/worker refuse to start when connected as a superuser/BYPASSRLS role (RLS would be a no-op).
OMNIRA_ALLOW_PRIVILEGED_DB=false

# Outbound media (ADR-0024): operators send images, audio, video and documents to customers. Off by default. Needs the antivirus
# (OMNIRA_CLAMAV_ADDR) and OMNIRA_MEDIA_DIR. With a host path for inbound media, keep uploads inside it:
#   OMNIRA_OUTBOUND_MEDIA_HOST_PATH=<OMNIRA_MEDIA_HOST_PATH>/outbound   (created by hand, owned by uid 1000, mode 700)
OMNIRA_OUTBOUND_MEDIA_ENABLED=false
# Service Hub API (/api/v1/hubs/..., reads and claim/reply). Keep false until migrations 093-095 are applied and the Hub is provisioned.
OMNIRA_HUB_API_ENABLED=false
# Worker: keep the Hub inbox projection in step with the tenants' conversations. Needs migrations 093+ and a provisioned Hub.
# Control plane (ADR-0038): create/suspend companies and switch their capabilities. Needs OMNIRA_HUB_API_ENABLED and a platform operator (omnira-hubctl platform-operator add).
OMNIRA_HUB_ADMIN_API_ENABLED=false
OMNIRA_HUB_PROJECTOR_ENABLED=false
OMNIRA_HUB_PROJECTOR_INTERVAL_SECONDS=60
# Message to the customer with the ticket number when an operator opens an external ticket (CRM/ERP). On unless set to false.
OMNIRA_TICKET_OPEN_NOTICE_ENABLED=true
OMNIRA_OUTBOUND_MEDIA_HOST_PATH=
