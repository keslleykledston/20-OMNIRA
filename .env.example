# OMNIRA — template de configuração. Copie para .env e preencha.
# .env NUNCA entra no Git. Nenhum valor real aqui, apenas placeholders.

# --- Aplicação ---
OMNIRA_ENV=development
OMNIRA_HTTP_ADDR=:8080
OMNIRA_DATABASE_URL=postgres://omnira:CHANGE_ME@localhost:55434/omnira_dev?sslmode=disable
OMNIRA_NATS_URL=nats://localhost:4222
OMNIRA_OTEL_ENDPOINT=http://localhost:4317
OMNIRA_AUTH_ISSUER=http://localhost:8080
OMNIRA_AUTH_AUDIENCE=omnira
OMNIRA_GRACEFUL_SHUTDOWN=30
# Base64 de exatamente 32 bytes aleatórios. Nunca use chave real aqui.
OMNIRA_CREDENTIALS_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# --- Local AI (OPCIONAL — otimização de engenharia, não dependência do produto) ---
# Desligue com LOCAL_AI_ENABLED=false: build, testes, CI e a aplicação
# continuam funcionando normalmente. Veja docs/architecture/LOCAL-AI.md.
LOCAL_AI_ENABLED=true
LOCAL_AI_BASE_URL=http://127.0.0.1:18088
LOCAL_AI_MODEL=hermes-3-llama-3.1-8b
LOCAL_AI_API_KEY=
LOCAL_AI_TIMEOUT=45
LOCAL_AI_MAX_INPUT_CHARS=12000
