[Unit]
Description=OMNIRA local speech-to-text (whisper.cpp on GPU) - ADR-0016
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=omnira-whisper
Group=omnira-whisper
Environment=PATH=/opt/omnira-whisper/bin/wrap:/usr/bin:/bin
# Listens only on the docker0 address: reachable from containers on this host, not from the LAN.
ExecStart=/opt/omnira-whisper/bin/whisper-server \
  -m /opt/omnira-whisper/models/ggml-large-v3-turbo-q5_0.bin \
  --host 172.17.0.1 --port 18181 \
  --convert --tmp-dir /var/lib/omnira-whisper \
  --public /opt/omnira-whisper/empty \
  -l auto -t 4 -sns
Restart=on-failure
RestartSec=5
UMask=0077

# --- sandbox: the process parses hostile audio, so it can touch nothing else ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=omnira-whisper
StateDirectoryMode=0700
ReadOnlyPaths=/opt/omnira-whisper
InaccessiblePaths=/data /mnt /media /root /srv /opt/omnira-media /opt/suporte-home /opt/k3g-ai-stack
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_INET AF_UNIX
# no internet: only loopback, the docker0 gateway and the OMNIRA compose network
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8 172.17.0.1/32 192.168.128.0/20
# GPU access only
DevicePolicy=closed
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw
DeviceAllow=/dev/nvidia-modeset rw
MemoryMax=6G
TasksMax=256
CPUQuota=800%

[Install]
WantedBy=multi-user.target
