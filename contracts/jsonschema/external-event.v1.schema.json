          "const": "ticket.linked.v1"
        },
        "version": {
          "const": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "tenant_id": {
          "$ref": "#/$defs/uuid"
        },
        "aggregate": {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "const": "ticket"
            },
            "id": {
              "$ref": "#/$defs/uuid"
            }
          }
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider"
          ],
          "properties": {
            "provider": {
              "type": "string"
            }
          }
        },
        "conversation_id": {
          "$ref": "#/$defs/uuid"
        }
      }
    }
  ]
}
